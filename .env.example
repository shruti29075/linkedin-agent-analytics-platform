# Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit your .env file to Git!

# Database Configuration
DATABASE_URL=sqlite:///database/warehouse.db

# API Integration & Authentication
POLLUXA_API_URL=https://sales.polluxa.com/api/v1
POLLUXA_API_KEY=your_api_key_here
POLLUXA_SESSION_COOKIE=your_secure_session_cookie_here

# Pipeline Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
